{
  "name": "molip-gak",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web && ait build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:audio": "node scripts/audio-check.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "perf": "node scripts/perf.mjs",
    "build:web": "tsc --noEmit && vite build",
    "deploy": "ait deploy",
    "build:engine": "vite build -c vite.engine.config.ts",
    "build:site": "tsc --noEmit && vite build --mode web && npm run build:engine",
    "serve": "node server/index.mjs",
    "test:server": "node scripts/server-check.mjs",
    "dev:web": "vite --mode web",
    "check:toss": "node scripts/toss-preflight.mjs",
    "store-assets": "node scripts/store-assets.mjs"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "^3.6.0",
    "@emotion/react": "^11.14.0",
    "@toss/tds-mobile": "^2.5.1",
    "@toss/tds-mobile-ait": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
