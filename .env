# Shared by all builds (overridden per mode, e.g. .env.web)
# VITE_SITE_TITLE is the app name shown by Toss — it must match the name registered in the console.
VITE_SITE_TITLE=몰입각
VITE_SITE_DESCRIPTION=공부할 때 틀어두는 집중 사운드. 빗소리·카페·노이즈와 집중 사운드(바이노럴 비트)를 섞고, 타이머로 집중시간을 기록해요.
VITE_THEME_COLOR="#F5F2EE"
# Toss banner ad group ID (console → 인앱 광고 → 광고 그룹). Test ID until the real one is issued:
# never test with the real ID, and replace this before requesting review (npm run check:toss warns).
VITE_TOSS_AD_BANNER_ID=ait-ad-test-banner-id
